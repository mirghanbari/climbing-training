{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-training-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",

  "observability": { "enabled": true },

  "vars": {
    // Origins allowed to call the API. Add a local dev origin while testing.
    "ALLOWED_ORIGINS": "https://mirghanbari.github.io,http://localhost:8000"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "climbing-training",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
